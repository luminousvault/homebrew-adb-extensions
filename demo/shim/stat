#!/usr/bin/python3
# Toybox/GNU 'stat [-L] -c FORMAT path...' for the fake device (macOS stat has no -c).
# Formats: %F type, %s size, %Y mtime, %n name, %a octal mode.
import os, stat, sys

args = sys.argv[1:]
follow, fmt, paths = False, None, []
while args:
    a = args.pop(0)
    if a == "-L":
        follow = True
    elif a == "-c":
        fmt = args.pop(0)
    elif a == "-Lc":
        follow, fmt = True, args.pop(0)
    else:
        paths.append(a)

def kind(st):
    if stat.S_ISDIR(st.st_mode):
        return "directory"
    if stat.S_ISLNK(st.st_mode):
        return "symbolic link"
    if stat.S_ISREG(st.st_mode):
        return "regular empty file" if st.st_size == 0 else "regular file"
    return "unknown"

code = 0
for p in paths:
    try:
        st = os.stat(p) if follow else os.lstat(p)
    except OSError as e:
        sys.stderr.write("stat: cannot stat '%s': %s\n" % (p, e.strerror))
        code = 1
        continue
    out = (fmt.replace("%F", kind(st)).replace("%s", str(st.st_size))
           .replace("%Y", str(int(st.st_mtime))).replace("%a", "%o" % (st.st_mode & 0o777))
           .replace("%n", p))
    sys.stdout.write(out + "\n")
sys.exit(code)
