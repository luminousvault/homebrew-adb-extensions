# Shared settings, read with 'Source demo/settings.tape'.
# Each tape then runs demo/setup.sh while hidden (fake home, fake adb, sample APKs).
Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 560
Set Padding 24
Set Theme "Dracula"
Set TypingSpeed 60ms
Set Framerate 24
Set CursorBlink false
