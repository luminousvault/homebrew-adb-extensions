# 출력 파일과 화면 설정
Output demo/install.gif
Set FontSize 16
Set Width 1200
Set Height 500
Set Theme "Dracula"
Set TypingSpeed 80ms

# 실제 시연
Type "ak install"
Sleep 500ms
Enter
Sleep 2s          # 인터랙티브 APK 목록이 뜰 때까지 대기

Down              # 방향키로 탐색
Sleep 500ms
Space             # 선택 토글
Sleep 800ms
Enter             # 설치 실행
Sleep 7s         # 설치 진행·완료 메시지 보여주기