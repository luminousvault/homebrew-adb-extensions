#!/usr/bin/env bash
# fake-adb: a stand-in for adb used to record the README demos.
#
# ak runs it through AK_ADB=/path/to/demo/fake-adb. It answers the adb calls
# the demos make with fixed output, so no real device (and no real serial)
# ever shows up, and anyone can re-record the GIFs.
#
# Devices:
#   emulator-5554  Google Pixel 9       Android 16 (API 36)
#   emulator-5556  Samsung Galaxy S25   Android 15 (API 35)
#
# Environment:
#   AK_DEMO_DEVICES=1          only emulator-5554 is connected (default: both)
#   AK_DEMO_SCENARIO=conflict  the Galaxy rejects the first install with
#                              INSTALL_FAILED_UPDATE_INCOMPATIBLE; after
#                              'uninstall' it succeeds
#   AK_DEMO_STATE=<dir>        where the scenario keeps state between calls
#                              (default: $TMPDIR/ak-demo)
#
# logcat: com.example.app (pid 4321) is running; com.example.shop starts
# (pid 4410) partway through the log, and only then shows up in 'ps'.

set -u
self=$0
[ -L "$self" ] && self=$(readlink "$self") # demo/setup.sh links it in as .../platform-tools/adb
here=$(cd "$(dirname "$self")" && pwd)
state=${AK_DEMO_STATE:-${TMPDIR:-/tmp}/ak-demo}

# adb -s <serial> <command...>
serial=""
if [ "${1:-}" = "-s" ]; then
  serial=$2
  shift 2
fi

getprop() { # brand model release sdk
  printf '[ro.build.version.release]: [%s]\n[ro.build.version.sdk]: [%s]\n' "$3" "$4"
  printf '[ro.product.brand]: [%s]\n[ro.product.model]: [%s]\n' "$1" "$2"
  printf '[ro.product.cpu.abi]: [arm64-v8a]\n[ro.product.cpu.abilist32]: []\n[ro.product.cpu.abilist64]: [arm64-v8a]\n'
}

# Seconds one install takes on each device, so the status board has something to show.
install_time() {
  case "$serial" in
    emulator-5554) echo 2 ;;
    *) echo 3.5 ;;
  esac
}

case "${1:-}" in
version)
  echo "Android Debug Bridge version 1.0.41"
  echo "Version 36.0.0-13206524"
  ;;

devices)
  echo "List of devices attached"
  echo "emulator-5554	device"
  [ "${AK_DEMO_DEVICES:-2}" = 1 ] || echo "emulator-5556	device"
  echo
  ;;

shell)
  case "${2:-}" in
  "ps -A -o PID,NAME")
    echo "PID NAME"
    echo "1000 system_server"
    echo "4321 com.example.app"
    [ -e "$state/shop-started" ] && echo "4410 com.example.shop"
    ;;
  getprop)
    case "$serial" in
    emulator-5554) getprop google "Pixel 9" 16 36 ;;
    emulator-5556) getprop samsung "Galaxy S25" 15 35 ;;
    esac
    ;;
  esac
  # Any other shell command: no output, like a quiet success.
  ;;

install)
  apk="${*: -1}"
  echo "Performing Streamed Install"
  if [ "${AK_DEMO_SCENARIO:-}" = conflict ] && [ "$serial" = emulator-5556 ] &&
    [ ! -e "$state/uninstalled" ]; then
    sleep 1.5 # the signature check fails early
    echo "adb: failed to install $apk: Failure [INSTALL_FAILED_UPDATE_INCOMPATIBLE: Existing package com.example.app signatures do not match newer version; ignoring!]" >&2
    exit 1
  fi
  sleep "$(install_time)"
  echo "Success"
  ;;

uninstall)
  sleep 1
  mkdir -p "$state" && touch "$state/uninstalled"
  echo "Success"
  ;;

logcat)
  # logcat -v threadtime: the buffer first, then new lines as they come.
  line() { # delay time pid tid level tag message
    sleep "$1"
    printf '11-13 10:28:%s  %s  %s %s %s: %s\n' "$2" "$3" "$4" "$5" "$6" "$7"
  }
  [ "${2:-}" = -c ] && exit 0 # logcat -c: clear the buffer
  mkdir -p "$state"
  line 0 26.008 4321 4321 I SplashActivity "onCreate: savedInstanceState=null"
  line 0 26.041 4321 4350 D ViewRootImpl "relayoutWindow: viewVisibility=0"
  line 0 26.052 4321 4321 D Billing "connecting to the store (timeout 15 s)"
  line 0 26.090 4321 4380 D HWUI "Using FreeType backend"
  line 0.6 26.702 1000 1100 I ActivityManager "Start proc 4410:com.example.shop/u0a124 for service {com.example.shop/.BillingService}"
  touch "$state/shop-started"
  line 0.5 27.214 4410 4410 D StoreService "bind from com.example.app"
  line 0.4 27.618 4410 4430 D StoreApi "GET /v1/products?ids=coin_small,coin_large"
  line 0.5 28.120 4410 4430 I StoreApi "200 OK 142ms"
  line 0.3 28.433 4321 4321 D Billing "connected 328ms"
  line 0.4 28.837 4321 4321 D Billing "→ queryProductDetails ids=[coin_small, coin_large]"
  line 0.5 29.342 4321 4360 V BillingClient 'Got product details: {"productId":"coin_small","price":"1200","priceCurrencyCode":"KRW","title":"Small coin pack","type":"inapp"}'
  line 0.2 29.551 4321 4321 I Choreographer "Skipped 31 frames!  The application may be doing too much work on its main thread."
  line 0.8 30.360 4321 4321 D Billing "→ launchPurchaseFlow productId=coin_small"
  line 0.6 30.962 4410 4430 W StoreApi "slow response: POST /v1/purchases took 1840ms"
  line 0.5 31.470 4321 4321 E Billing "purchase failed: responseCode=1 (USER_CANCELED)"
  line 0 31.475 4321 4380 W qdgralloc "getInterlacedFlag: getMetaData returned 3"
  exec sleep 3600 # follow: wait for more, like the real logcat (exec: stopping adb closes the output)
  ;;

exec-out)
  # exec-out screencap -p
  sleep 0.8
  cat "$here/assets/screen.png"
  ;;

*)
  echo "fake-adb: not simulated: $*" >&2
  exit 1
  ;;
esac
