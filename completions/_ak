#compdef ak
# zsh completion for ak — generated by 'ak completion zsh', do not edit.

# Serials of connected devices for -s/--serial (ak finds adb itself).
_ak_serials() {
  local -a serials
  serials=(${(f)"$(ak __serials 2>/dev/null)"})
  _describe 'device serial' serials
}

_ak() {
  local -a commands
  commands=(
    'activities:Show activity stack'
    'clear:Clear app data and cache'
    'completion:Print a shell completion script'
    'devices:Show connected devices'
    'doctor:Check adb, devices and shell setup'
    'extract:Save the APK of an installed app'
    'info:Show app version and SDK levels'
    'install:Install APKs on one or more devices'
    'kill:Force-stop apps'
    'launch:Launch an app'
    'logcat:Show logs of one app'
    'mac:Show device MAC addresses'
    'permissions:List granted permissions of an app'
    'pull:Pick recent files on a device and copy them here'
    'record:Record the screen'
    'restart:Restart an app and time its launch'
    'screenshot:Capture the screen to a file or the clipboard'
    'signature:Show signing certificate hashes'
    'uninstall:Uninstall an app'
    'wifi:Switch a device to Wi-Fi debugging'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message]' \
    '(- *)'{-v,--version}'[Show version]' \
    '--no-color[Disable colored output]' \
    '1:command:->command' \
    '*::arg:->args' && return 0

  case $state in
    command)
      _describe 'ak commands' commands
      ;;
    args)
      case $words[1] in
        activities)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-e,--every-task}'[Show every task]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '--json[Print the result as JSON]'
          ;;
        clear)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '*:package name:_message "package name"'
          ;;
        completion)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            '1:shell:(zsh bash fish powershell)'
          ;;
        devices)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            '--json[Print the result as JSON]'
          ;;
        doctor)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-v,--verbose}'[Show all details]' \
            '--json[Print the result as JSON]'
          ;;
        extract)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:package name or save file name:_message "package name or save file name"' \
            '2:save file name or package name:_path_files -/'
          ;;
        info)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '--json[Print the result as JSON]' \
            '1:package name:_message "package name"'
          ;;
        install)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            '(-e --every-apk -f --filter)'{-l,--latest}'[Install the newest APK]' \
            '(-l --latest -f --filter)'{-e,--every-apk}'[Install every APK]' \
            '(-l --latest -e --every-apk)'{-f,--filter}'[Pick among APKs whose names contain all the words]:words' \
            '-r[Replace the existing app, keeping its data]' \
            {-t,--test-only}'[Allow test-only APKs]' \
            {-d,--downgrade}'[Allow version downgrade]' \
            {-y,--yes}'[Uninstall and reinstall without asking when a device refuses the update]' \
            '*'{-s,--serial}'[Target device]:serial:_ak_serials' \
            {-a,--all}'[All connected devices]' \
            '*:APK files or directories:_path_files -g "*.apk(-.)" -/'
          ;;
        kill)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '*:package name:_message "package name"'
          ;;
        launch)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:package name:_message "package name"'
          ;;
        logcat)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-l,--level}'[Minimum level\: V, D, I, W, E or F]:level:(V D I W E F)' \
            {-c,--clear}'[Clear the device log buffer first]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:package name:_message "package name"'
          ;;
        mac)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            '*'{-s,--serial}'[Target device]:serial:_ak_serials' \
            {-a,--all}'[All connected devices]' \
            '--json[Print the result as JSON]'
          ;;
        permissions)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '--json[Print the result as JSON]' \
            '1:package name:_message "package name"'
          ;;
        pull)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-y,--yes}'[Create the destination directory without asking if it does not exist]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:destination directory:_path_files -/'
          ;;
        record)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-t,--time-limit}'[Stop after this many seconds]:seconds' \
            '--size[Video size, e.g. 1280x720]:wxh' \
            {-o,--open}'[Open the saved file with the default app]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:output directory:_path_files -/'
          ;;
        restart)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-r,--repeat}'[Restart N times]:n' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '--json[Print the result as JSON]' \
            '1:package name:_message "package name"'
          ;;
        screenshot)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-c,--clipboard}'[Copy the image to the clipboard]' \
            {-o,--open}'[Open the saved file with the default app]' \
            '*'{-s,--serial}'[Target device]:serial:_ak_serials' \
            {-a,--all}'[All connected devices]' \
            '1:output directory:_path_files -/'
          ;;
        signature)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '--json[Print the result as JSON]' \
            '1:package name or APK file:_path_files -g "*.apk(-.)" -/'
          ;;
        uninstall)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:package name:_message "package name"'
          ;;
        wifi)
          _arguments -s \
            '(- *)'{-h,--help}'[Show help for this command]' \
            {-p,--port}'[TCP port]:port' \
            {-s,--serial}'[Target device]:serial:_ak_serials' \
            '1:action:(off)'
          ;;
        *)
          _arguments -s '(- *)'{-h,--help}'[Show help for this command]'
          ;;
      esac
      ;;
  esac
}

# Autoloaded from fpath it runs _ak; sourced (source <(ak completion zsh)) it registers it.
if [ "$funcstack[1]" = "_ak" ]; then
  _ak "$@"
else
  compdef _ak ak
fi
